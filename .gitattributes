# Normalize line endings: text files are stored and checked out with LF.
* text=auto eol=lf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.blend binary
*.fbx binary
*.ttf binary
*.otf binary
*.pck binary
